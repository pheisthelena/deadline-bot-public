# Пример файла настроек. Скопируйте его под именем config.env и впишите свои значения.
# Каждая строка: ИМЯ=значение, без пробелов вокруг знака "=" и без кавычек.
# Настоящий config.env секретный: не выкладывайте его в открытый репозиторий.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCDEF...

# Чаты, куда бот пишет: ваш личный chat id и id чата группы, через запятую.
# Первый положительный id считается владельцем бота (ему приходят служебные сообщения).
CHAT_ID=111111111,-1001234567890

# Необязательно: ссылка на экспорт календаря SmartLMS (Календарь -> Экспорт календаря)
SMARTLMS_ICS=

# Необязательно: чаты, которые бот только читает и куда никогда не пишет.
# Формат: id_чата:Название предмета, несколько чатов через запятую.
SILENT_CHATS=
